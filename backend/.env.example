# English Udaan API — environment template
# Copy this file to .env and fill in real values.
# NEVER commit .env or real credentials to version control.

# Server runtime
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3000

# Mobile API base URL. Pass this to Flutter with:
# flutter run --dart-define=API_BASE_URL=http://<reachable-lan-host>:3000
# Use https://... for a deployed API. Do not use 10.0.2.2 on a physical phone.
API_BASE_URL=http://10.0.2.2:3000

# MongoDB Atlas — Phase 14
# Obtain your connection string from Atlas UI (Connect > Drivers > Node.js).
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DATABASE=test

# Firebase Admin — Phase 15
# The Firebase project ID is NOT a secret; it appears in google-services.json.
# For this project the project ID is: english-udaan
FIREBASE_PROJECT_ID=english-udaan

# Credentials for Firebase Admin (choose ONE of the following approaches):
#
# OPTION A — Application Default Credentials (recommended for production and CI)
#   1. Install the Google Cloud SDK: https://cloud.google.com/sdk/docs/install
#   2. Run: gcloud auth application-default login
#   3. No additional environment variable is needed — the SDK finds ADC automatically.
#
# OPTION B — Service account key file (local dev only; never commit the file)
#   1. In the Firebase console: Project Settings > Service accounts > Generate new private key.
#   2. Save the downloaded JSON file outside your repository (e.g. ~/secrets/english-udaan-sa.json).
#   3. Set the path in this variable:
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/english-udaan-sa.json
#
# ── AI Dictionary provider (Phase 16) ──────────────────────────────────────────
#
# The dictionary endpoint searches the MongoDB database first.
# Only if no entry is found AND AI_API_KEY is set will an AI provider be called.
# If AI_API_KEY is absent, the database still works and the UI reports that
# live AI lookup is unavailable — no crash, no fake data.
#
# Choose ONE provider and set the matching key:
#
# OPTION A — OpenAI  (default when AI_PROVIDER is omitted)
#   AI_PROVIDER=openai
#   AI_API_KEY=sk-...              ← your OpenAI secret key
#   AI_MODEL=gpt-4o-mini           ← optional; defaults to gpt-4o-mini
#
# OPTION B — Google Gemini
#   AI_PROVIDER=google
#   AI_API_KEY=AIzaSy...           ← your Google AI Studio API key
#   AI_MODEL=gemini-3.8-flash      ← optional; defaults to gemini-3.8-flash
#
# SECURITY RULES:
#   - NEVER commit a real AI_API_KEY to version control.
#   - NEVER log or return AI_API_KEY in any response.
#   - Rotate the key immediately if it is accidentally exposed.
#
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=
